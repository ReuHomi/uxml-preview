{
  "name": "uxml-preview",
  "version": "0.1.0",
  "description": "Preview Unity UI Toolkit UXML/USS in a browser without the Unity Editor. Uses Yoga (WebAssembly), the same layout engine UI Toolkit uses: 242 of 244 element coordinates identical to Unity 6. Parses and writes files back byte-for-byte.",
  "keywords": [
    "unity", "unity3d", "ui-toolkit", "uitk", "uielements", "uxml", "uss",
    "yoga", "yoga-layout", "flexbox", "webassembly", "renderer", "preview",
    "game-ui", "typescript", "editor-tooling", "unity-editor", "css-to-uss"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE", "THIRD-PARTY-NOTICES.md", "CHANGELOG.md"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ReuHomi/uxml-preview.git"
  },
  "homepage": "https://reuhomi.github.io/uxml-preview/",
  "bugs": { "url": "https://github.com/ReuHomi/uxml-preview/issues" },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:site": "vite build --config vite.playground.config.ts",
    "preview:site": "vite preview --config vite.playground.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:roundtrip": "vitest run tests/roundtrip",
    "test:golden": "vitest run tests/golden --passWithNoTests",
    "golden:emit": "node --experimental-strip-types --no-warnings scripts/emit-golden-cases.mjs",
    "golden:update": "node scripts/update-golden.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "yoga-layout": "^3.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jsdom": "^30.0.1",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@9.12.0"
}
