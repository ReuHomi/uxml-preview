<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
<ui:VisualElement name="col" style="width: 300px;">
<ui:RadioButton name="with" label="Label" />
<ui:RadioButton name="without"  />
<ui:RadioButton name="colored" label="Label" style="color: rgb(255, 0, 0); font-size: 20px;" />
</ui:VisualElement>
<ui:VisualElement name="parent" style="width: 300px; color: rgb(0, 0, 255); font-size: 16px;">
<ui:RadioButton name="inherits" label="Label" />
</ui:VisualElement>
<ui:VisualElement name="free" style="align-items: flex-start;">
<ui:RadioButton name="auto" label="Label" />
</ui:VisualElement>
</ui:UXML>
