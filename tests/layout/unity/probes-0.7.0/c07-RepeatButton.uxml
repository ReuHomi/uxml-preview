<ui:UXML xmlns:ui="UnityEngine.UIElements">
<ui:VisualElement name="col" style="width: 300px;">
<ui:RepeatButton name="rb-plain" />
<ui:RepeatButton name="rb-text" text="Repeat" />
<ui:RepeatButton name="rb-disabled" text="Repeat" enabled="false" />
</ui:VisualElement>
<ui:VisualElement name="free" style="align-items: flex-start;">
<ui:RepeatButton name="rb-auto" text="Repeat" />
</ui:VisualElement>
</ui:UXML>
