<ui:SliderInt name="si-input" low-value="0" high-value="10" value="5" show-input-field="true" />
<ui:SliderInt name="si-disabled" low-value="0" high-value="10" value="5" enabled="false" />
</ui:VisualElement>
<ui:VisualElement name="free" style="align-items: flex-start;">
